set(_config_dir "@YATE_INSTALL_CONFIGDIR@")
if(NOT IS_ABSOLUTE "${_config_dir}")
    set(_config_dir "${CMAKE_INSTALL_PREFIX}/${_config_dir}")
endif()
set(_config_sources "@YATE_CONFIG_FILES@")
foreach(_source IN LISTS _config_sources)
    get_filename_component(_name "${_source}" NAME)
    string(REGEX REPLACE "\\.(sample|default)$" "" _name "${_name}")
    # file(INSTALL) добавляет DESTDIR самостоятельно; проверяем уже полный путь.
    set(_existing "$ENV{DESTDIR}${_config_dir}/${_name}")
    if(NOT EXISTS "${_existing}" AND NOT IS_SYMLINK "${_existing}")
        file(INSTALL "${_source}" DESTINATION "${_config_dir}" RENAME "${_name}")
    else()
        message(STATUS "Preserving configuration: ${_config_dir}/${_name}")
    endif()
endforeach()
