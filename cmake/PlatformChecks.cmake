include(CheckCSourceCompiles)
include(CheckCXXSourceCompiles)
include(CheckCXXCompilerFlag)
include(CheckSymbolExists)
include(CheckStructHasMember)
include(CheckIncludeFile)
include(CMakePushCheckState)
include(TestBigEndian)
set(THREADS_PREFER_PTHREAD_FLAG TRUE)
find_package(Threads REQUIRED)

add_library(yate_build_options INTERFACE)
target_compile_options(yate_build_options INTERFACE -Wall
    "$<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions>")
target_compile_definitions(yate_build_options INTERFACE "$<$<CONFIG:Debug>:DEBUG>")
check_cxx_compiler_flag(-Wno-overloaded-virtual YATE_NO_OVERLOADED_VIRTUAL)
if(YATE_NO_OVERLOADED_VIRTUAL)
    target_compile_options(yate_build_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-Wno-overloaded-virtual>")
endif()
string(TOUPPER "${YATE_RTTI}" YATE_RTTI)
if(YATE_RTTI STREQUAL "ON")
    target_compile_options(yate_build_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-frtti>")
elseif(YATE_RTTI STREQUAL "OFF")
    target_compile_options(yate_build_options INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>")
elseif(NOT YATE_RTTI STREQUAL "AUTO")
    message(FATAL_ERROR "YATE_RTTI must be AUTO, ON or OFF")
endif()

set(YATE_PUBLIC_DEFINITIONS "")
test_big_endian(YATE_BIG_ENDIAN)
if(YATE_BIG_ENDIAN)
    list(APPEND YATE_PUBLIC_DEFINITIONS BIGENDIAN)
endif()
check_cxx_source_compiles("void f(void*,const char*,...) __attribute__((format(printf,2,3))); int main() { return 0; }" YATE_FORMAT_CHECK)
if(YATE_FORMAT_CHECK)
    list(APPEND YATE_PUBLIC_DEFINITIONS HAVE_GCC_FORMAT_CHECK)
endif()
if(YATE_STATIC_STRINGS)
    check_cxx_source_compiles("int main() { return ({static int ret=0;ret;}); }" YATE_BLOCK_RETURN)
    if(YATE_BLOCK_RETURN)
        list(APPEND YATE_PUBLIC_DEFINITIONS HAVE_BLOCK_RETURN)
    endif()
endif()
if(YATE_ATOMICS)
    check_c_source_compiles("int main() { int i=0; int j=__sync_add_and_fetch(&i,1); return __sync_fetch_and_sub(&j,1); }" YATE_HAVE_ATOMICS)
    if(YATE_HAVE_ATOMICS)
        list(APPEND YATE_PUBLIC_DEFINITIONS ATOMIC_OPS)
    endif()
endif()

set(YATE_PLATFORM_DEFINITIONS "")
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
set(CMAKE_REQUIRED_LIBRARIES Threads::Threads)
foreach(_symbol pthread_mutex_timedlock sem_timedwait pthread_rwlock_timedrdlock pthread_rwlock_timedwrlock)
    check_symbol_exists(${_symbol} "pthread.h;semaphore.h;time.h" YATE_${_symbol})
endforeach()
foreach(_pair "pthread_mutex_timedlock|HAVE_TIMEDLOCK" "sem_timedwait|HAVE_TIMEDWAIT"
              "pthread_rwlock_timedrdlock|HAVE_TIMEDRDLOCK" "pthread_rwlock_timedwrlock|HAVE_TIMEDWRLOCK")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _symbol)
    list(GET _pair 1 _definition)
    if(YATE_${_symbol})
        list(APPEND YATE_PLATFORM_DEFINITIONS ${_definition})
    endif()
endforeach()
check_c_source_compiles("#include <pthread.h>\nint main() { pthread_mutexattr_t a; return pthread_mutexattr_settype(&a,PTHREAD_MUTEX_RECURSIVE_NP); }" YATE_RECURSIVE_MUTEX)
if(NOT YATE_RECURSIVE_MUTEX)
    list(APPEND YATE_PLATFORM_DEFINITIONS MUTEX_HACK)
endif()
check_symbol_exists(pthread_setaffinity_np "pthread.h" YATE_THREAD_AFFINITY)
check_symbol_exists(sched_setaffinity "sched.h" YATE_SCHED_AFFINITY)
if(YATE_THREAD_AFFINITY)
    list(APPEND YATE_PLATFORM_DEFINITIONS THREAD_AFFINITY)
elseif(YATE_SCHED_AFFINITY)
    list(APPEND YATE_PLATFORM_DEFINITIONS SCHED_AFFINITY)
endif()
check_symbol_exists(pthread_kill_other_threads_np "pthread.h" YATE_THREAD_KILL)
if(YATE_THREAD_KILL)
    list(APPEND YATE_PLATFORM_DEFINITIONS THREAD_KILL)
endif()
foreach(_pair "getcwd|unistd.h|HAVE_GETCWD" "prctl|sys/prctl.h|HAVE_PRCTL"
              "inet_ntop|arpa/inet.h|HAVE_NTOP" "inet_pton|arpa/inet.h|HAVE_PTON"
              "gethostbyname_r|netdb.h|HAVE_GHBN_R" "gethostbyname2_r|netdb.h|HAVE_GHBN2_R"
              "gethostbyname2|netdb.h|HAVE_GHBN2" "timezone|time.h|HAVE_INT_TZ")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _symbol)
    list(GET _parts 1 _header)
    list(GET _parts 2 _definition)
    check_symbol_exists(${_symbol} "${_header}" YATE_${_definition})
    if(YATE_${_definition})
        list(APPEND YATE_PLATFORM_DEFINITIONS ${_definition})
    endif()
endforeach()
check_struct_has_member("struct sockaddr" sa_len "sys/socket.h" YATE_HAVE_SOCKADDR_LEN)
check_struct_has_member("struct tm" tm_gmtoff "time.h" YATE_HAVE_GMTOFF)
foreach(_definition HAVE_SOCKADDR_LEN HAVE_GMTOFF)
    if(YATE_${_definition})
        list(APPEND YATE_PLATFORM_DEFINITIONS ${_definition})
    endif()
endforeach()
if(YATE_POLL)
    check_symbol_exists(poll "poll.h" YATE_HAVE_POLL)
    if(YATE_HAVE_POLL)
        list(APPEND YATE_PLATFORM_DEFINITIONS HAVE_POLL)
    endif()
endif()
if(NOT YATE_FDSIZE MATCHES "^[0-9]+$")
    message(FATAL_ERROR "YATE_FDSIZE must be a non-negative integer")
endif()
if(YATE_FDSIZE GREATER 0)
    check_c_source_compiles("#include <features.h>\n#ifndef __GLIBC__\n#error Not glibc\n#endif\n#include <bits/types.h>\nint main() { return __FD_SETSIZE > 10 ? 0 : 1; }" YATE_CAN_SET_FDSIZE)
    if(YATE_CAN_SET_FDSIZE)
        list(APPEND YATE_PLATFORM_DEFINITIONS FDSIZE_HACK=${YATE_FDSIZE})
    endif()
endif()
cmake_pop_check_state()

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_regex_default OFF)
else()
    set(_regex_default ON)
endif()
option(YATE_INTERNAL_REGEX "Use the bundled regular expression implementation" ${_regex_default})
