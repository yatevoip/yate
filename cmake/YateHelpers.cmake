function(yate_absolute_install_path output directory)
    if(IS_ABSOLUTE "${directory}")
        set(${output} "${directory}" PARENT_SCOPE)
    else()
        set(${output} "${CMAKE_INSTALL_PREFIX}/${directory}" PARENT_SCOPE)
    endif()
endfunction()

function(yate_install_rpath target directory)
    yate_absolute_install_path(_from "${directory}")
    yate_absolute_install_path(_to "${CMAKE_INSTALL_LIBDIR}")
    file(RELATIVE_PATH _relative "${_from}" "${_to}")
    if(APPLE)
        set(_origin "@loader_path")
    else()
        set(_origin "$ORIGIN")
    endif()
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "${_origin}/${_relative}")
endfunction()

# AUTO включает компонент при наличии совместимой зависимости.
# ON требует зависимость и сообщает об ошибке уже при настройке сборки.
macro(yate_dependency_option name description)
    set(YATE_WITH_${name} AUTO CACHE STRING "${description}: AUTO, ON or OFF")
    set_property(CACHE YATE_WITH_${name} PROPERTY STRINGS AUTO ON OFF)
    string(TOUPPER "${YATE_WITH_${name}}" YATE_WITH_${name})
    if(NOT YATE_WITH_${name} MATCHES "^(AUTO|ON|OFF)$")
        message(FATAL_ERROR "YATE_WITH_${name} must be AUTO, ON or OFF")
    endif()
endmacro()

macro(yate_dependency_result name available)
    set(YATE_HAVE_${name} FALSE)
    if(NOT YATE_WITH_${name} STREQUAL "OFF")
        if(${available})
            set(YATE_HAVE_${name} TRUE)
        elseif(YATE_WITH_${name} STREQUAL "ON")
            message(FATAL_ERROR "YATE_WITH_${name}=ON but ${name} is not available or its API is incompatible")
        endif()
    endif()
endmacro()

function(yate_library name directory kind)
    add_library(${name} ${kind} ${ARGN})
    target_link_libraries(${name} PUBLIC libyate PRIVATE "$<BUILD_INTERFACE:yate_build_options>")
    target_include_directories(${name} PUBLIC
        "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/libs/${directory}>"
        "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/yate>")
    set_target_properties(${name} PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/libs/${directory}")
    if(kind STREQUAL "SHARED")
        set_target_properties(${name} PROPERTIES VERSION "${PROJECT_VERSION}" SOVERSION "${PROJECT_VERSION}")
        yate_install_rpath(${name} "${CMAKE_INSTALL_LIBDIR}")
    endif()
    install(TARGETS ${name} EXPORT YateTargets
        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
endfunction()

function(yate_module name source)
    cmake_parse_arguments(MOD "TEST" "FEATURE" "LIBRARIES;INCLUDES;DEFINITIONS" ${ARGN})
    set_property(GLOBAL APPEND PROPERTY YATE_KNOWN_MODULES "${name}")
    if(NOT MOD_TEST AND NOT YATE_MODULES STREQUAL "all")
        if(NOT name IN_LIST YATE_MODULES)
            return()
        endif()
    endif()
    if(MOD_FEATURE AND NOT YATE_HAVE_${MOD_FEATURE})
        if(NOT YATE_MODULES STREQUAL "all" AND name IN_LIST YATE_MODULES)
            message(FATAL_ERROR "Requested module ${name} needs unavailable ${MOD_FEATURE}")
        endif()
        set_property(GLOBAL APPEND PROPERTY YATE_DISABLED_MODULES "${name} (${MOD_FEATURE})")
        return()
    endif()
    get_filename_component(_subdir "${source}" DIRECTORY)
    add_library(${name} MODULE "${source}")
    target_link_libraries(${name} PRIVATE libyate yate_build_options ${MOD_LIBRARIES})
    if(MOD_INCLUDES)
        target_include_directories(${name} PRIVATE ${MOD_INCLUDES})
    endif()
    if(MOD_DEFINITIONS)
        target_compile_definitions(${name} PRIVATE ${MOD_DEFINITIONS})
    endif()
    set_target_properties(${name} PROPERTIES PREFIX "" SUFFIX ".yate"
        LIBRARY_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/modules/${_subdir}")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(${name} PRIVATE "-Wl,--no-undefined")
    endif()
    yate_install_rpath(${name} "${YATE_INSTALL_MODULEDIR}/${_subdir}")
    if(NOT MOD_TEST)
        install(TARGETS ${name} LIBRARY DESTINATION "${YATE_INSTALL_MODULEDIR}/${_subdir}")
        set_property(GLOBAL APPEND PROPERTY YATE_ENABLED_MODULES "${name}")
    endif()
endfunction()
