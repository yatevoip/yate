set(YATE_WANPIPE_DEFINITIONS "")
set(YATE_WANPIPE_INCLUDES "")
find_path(YATE_WANPIPE_INCLUDE_DIR wanpipe.h PATH_SUFFIXES wanpipe)
cmake_push_check_state(RESET)
set(_wanpipe FALSE)
set(_wp_prefix "#define __LINUX__\n#include <sys/types.h>\n#include <sys/ioctl.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n")
if(YATE_WANPIPE_INCLUDE_DIR)
    set(CMAKE_REQUIRED_INCLUDES "${YATE_WANPIPE_INCLUDE_DIR}")
    set(_wp_headers "${_wp_prefix}#include <if_wanpipe.h>\n#include <wanpipe_defines.h>\n#include <wanpipe_cfg.h>\n#include <wanpipe.h>\n")
    check_c_source_compiles("${_wp_headers}#include <aft_core.h>\nint main() { return 0; }" YATE_WANPIPE_NEW_API)
    check_c_source_compiles("${_wp_headers}#include <sdla_aft_te1.h>\nint main() { return 0; }" YATE_WANPIPE_OLD_API)
    if(YATE_WANPIPE_NEW_API OR YATE_WANPIPE_OLD_API)
        set(_wanpipe TRUE)
        list(APPEND YATE_WANPIPE_DEFINITIONS HAVE_WANPIPE_API)
        list(APPEND YATE_WANPIPE_INCLUDES "${YATE_WANPIPE_INCLUDE_DIR}")
        if(YATE_WANPIPE_NEW_API)
            list(APPEND YATE_WANPIPE_DEFINITIONS NEW_WANPIPE_API)
        endif()
    endif()
    check_c_source_compiles("${_wp_prefix}#include <wanpipe.h>\nint main() { wanpipe_api_t tdm; return 0; }" YATE_WANPIPE_TDM)
endif()
if(NOT _wanpipe)
    check_c_source_compiles("${_wp_prefix}#include <linux/if_wanpipe.h>\n#include <linux/if.h>\n#include <linux/wanpipe_defines.h>\n#include <linux/wanpipe_cfg.h>\n#include <linux/wanpipe.h>\n#include <linux/sdla_aft_te1.h>\nint main() { return 0; }" YATE_WANPIPE_LINUX_API)
    set(_wanpipe "${YATE_WANPIPE_LINUX_API}")
endif()
