foreach(_feature GSM SPEEX AMRNB LIBUSB COREDUMPER)
    if(_feature STREQUAL "GSM")
        set(_header gsm.h)
        set(_library gsm)
        set(_suffix gsm)
    elseif(_feature STREQUAL "SPEEX")
        set(_header speex/speex.h)
        set(_library speex)
        set(_suffix "")
    elseif(_feature STREQUAL "AMRNB")
        set(_header interf_enc.h)
        set(_library amrnb)
        set(_suffix amrnb)
    elseif(_feature STREQUAL "LIBUSB")
        set(_header libusb.h)
        set(_library usb-1.0)
        set(_suffix libusb-1.0)
    else()
        set(_header google/coredumper.h)
        set(_library coredumper)
        set(_suffix "")
    endif()
    find_path(YATE_${_feature}_INCLUDE_DIR "${_header}" PATH_SUFFIXES ${_suffix})
    find_library(YATE_${_feature}_LIBRARY NAMES "${_library}")
    set(_available FALSE)
    if(YATE_${_feature}_INCLUDE_DIR AND YATE_${_feature}_LIBRARY)
        set(_available TRUE)
        add_library(yate_${_feature} INTERFACE)
        target_include_directories(yate_${_feature} INTERFACE "${YATE_${_feature}_INCLUDE_DIR}")
        target_link_libraries(yate_${_feature} INTERFACE "${YATE_${_feature}_LIBRARY}")
    endif()
    if(_available AND _feature STREQUAL "AMRNB")
        cmake_push_check_state(RESET)
        set(CMAKE_REQUIRED_INCLUDES "${YATE_AMRNB_INCLUDE_DIR}")
        set(CMAKE_REQUIRED_LIBRARIES "${YATE_AMRNB_LIBRARY}")
        # Заголовки кодера и декодера конфликтуют; повторяем изоляцию из модуля.
        check_cxx_source_compiles("extern \"C\" {\n#include <interf_enc.h>\n#include <interf_dec.h>\n}\nnamespace RxTypes {\n#include <sp_dec.h>\n}\nint main() { return Encoder_Interface_init(0) == 0; }" YATE_AMRNB_API)
        set(_available "${YATE_AMRNB_API}")
        cmake_pop_check_state()
    endif()
    if(_available AND _feature STREQUAL "LIBUSB")
        # Наличие библиотеки ещё не гарантирует нужную модулю версию API.
        cmake_push_check_state(RESET)
        set(CMAKE_REQUIRED_INCLUDES "${YATE_LIBUSB_INCLUDE_DIR}")
        set(CMAKE_REQUIRED_LIBRARIES "${YATE_LIBUSB_LIBRARY}")
        check_symbol_exists(libusb_has_capability libusb.h YATE_LIBUSB_CAPABILITY_API)
        set(_available "${YATE_LIBUSB_CAPABILITY_API}")
        cmake_pop_check_state()
    endif()
    yate_dependency_result(${_feature} _available)
endforeach()
if(YATE_HAVE_LIBUSB)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_INCLUDES "${YATE_LIBUSB_INCLUDE_DIR}")
    set(CMAKE_REQUIRED_LIBRARIES "${YATE_LIBUSB_LIBRARY}")
    check_symbol_exists(libusb_get_version libusb.h YATE_LIBUSB_VERSION)
    cmake_pop_check_state()
endif()

set(_spandsp FALSE)
set(YATE_SPANDSP_DEFINITIONS "")
if(PkgConfig_FOUND)
    pkg_check_modules(SPANDSP QUIET IMPORTED_TARGET spandsp)
    if(SPANDSP_FOUND)
        cmake_push_check_state(RESET)
        set(CMAKE_REQUIRED_LIBRARIES PkgConfig::SPANDSP)
        set(_fax_headers "#define SPANDSP_EXPOSE_INTERNAL_STRUCTURES\n#include <math.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <spandsp.h>\n")
        check_c_source_compiles("${_fax_headers}int main() { fax_state_t f; t38_terminal_state_t t; t38_gateway_state_t g; fax_init(&f,1); fax_get_t30_state(&f); (void)t.t38_fe.t38; (void)t.t30; t38_terminal_init(&t,1,0,0); t38_gateway_init(&g,0,0); t38_terminal_release(&t); return 0; }" YATE_SPANDSP_006)
        if(YATE_SPANDSP_006)
            set(_spandsp TRUE)
        else()
            check_c_source_compiles("${_fax_headers}int main() { fax_state_t f; t38_terminal_state_t t; t38_gateway_state_t g; fax_init(&f,1); (void)f.t30_state; (void)t.t38; (void)t.t30_state; t38_terminal_init(&t,1,0,0); t38_gateway_init(&g,0,0); t38_terminal_release(&t); return 0; }" YATE_SPANDSP_OLD)
            if(YATE_SPANDSP_OLD)
                set(_spandsp TRUE)
                list(APPEND YATE_SPANDSP_DEFINITIONS SPANDSP_PRE006)
            endif()
        endif()
        if(_spandsp)
            # Новые версии разделяют статистику отправленных и принятых страниц.
            check_c_source_compiles("${_fax_headers}int main() { t30_stats_t s; s.pages_tx = s.pages_rx = 0; return 0; }" YATE_SPANDSP_TXRXSTATS)
            if(YATE_SPANDSP_TXRXSTATS)
                list(APPEND YATE_SPANDSP_DEFINITIONS SPANDSP_TXRXSTATS)
            else()
                check_c_source_compiles("${_fax_headers}int main() { t30_stats_t s; s.pages_transferred = 0; return 0; }" YATE_SPANDSP_LEGACY_STATS)
                if(NOT YATE_SPANDSP_LEGACY_STATS)
                    set(_spandsp FALSE)
                endif()
            endif()
        endif()
        cmake_pop_check_state()
    endif()
endif()
yate_dependency_result(SPANDSP _spandsp)

set(YATE_RESOLVER_LIBRARIES "")
set(YATE_RESOLVER_DEFINITIONS NO_RESOLV)
cmake_push_check_state(RESET)
set(_resolv_source "#include <netinet/in.h>\n#include <arpa/nameser.h>\n#include <resolv.h>\nint main() { unsigned char b[16]; res_init(); return res_query(\"localhost\",1,1,b,16); }")
check_c_source_compiles("${_resolv_source}" YATE_RESOLVER_IN_LIBC)
set(_resolver "${YATE_RESOLVER_IN_LIBC}")
if(NOT _resolver)
    find_library(YATE_RESOLV_LIBRARY resolv)
    if(YATE_RESOLV_LIBRARY)
        set(CMAKE_REQUIRED_LIBRARIES "${YATE_RESOLV_LIBRARY}")
        check_c_source_compiles("${_resolv_source}" YATE_RESOLVER_WITH_LIB)
        set(_resolver "${YATE_RESOLVER_WITH_LIB}")
        if(_resolver)
            set(YATE_RESOLVER_LIBRARIES "${YATE_RESOLV_LIBRARY}")
        endif()
    endif()
endif()
yate_dependency_result(RESOLVER _resolver)
if(YATE_HAVE_RESOLVER)
    set(YATE_RESOLVER_DEFINITIONS "")
    check_symbol_exists(dn_skipname "arpa/nameser.h;resolv.h" YATE_DN_SKIPNAME)
    if(NOT YATE_DN_SKIPNAME)
        set(YATE_RESOLVER_DEFINITIONS NO_DN_SKIPNAME)
    endif()
else()
    set(YATE_RESOLVER_LIBRARIES "")
endif()
cmake_pop_check_state()

cmake_push_check_state(RESET)
set(_sctp_headers "#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <netinet/sctp.h>\n")
find_library(YATE_SCTP_LIBRARY sctp)
check_include_file(netinet/sctp.h YATE_SCTP_HEADER)
set(_sctp FALSE)
if(YATE_SCTP_HEADER AND YATE_SCTP_LIBRARY)
    set(_sctp TRUE)
endif()
yate_dependency_result(SCTP _sctp)
set(YATE_SCTP_DEFINITIONS "")
if(NOT YATE_WITH_SCTP STREQUAL "OFF")
    check_c_source_compiles("#include <sys/socket.h>\n#include <netinet/in.h>\nint main() { return socket(PF_INET,SOCK_SEQPACKET,IPPROTO_SCTP); }" YATE_BASIC_SCTP)
    if(YATE_BASIC_SCTP)
        list(APPEND YATE_SCTP_DEFINITIONS HAVE_SCTP)
    endif()
    if(YATE_HAVE_SCTP)
        list(APPEND YATE_SCTP_DEFINITIONS HAVE_SCTP_NETINET)
        set(CMAKE_REQUIRED_LIBRARIES "${YATE_SCTP_LIBRARY}")
        foreach(_probe "HAVE_SCTP_CONNECTX_4|sctp_connectx(0,0,0,0)"
                       "HAVE_SETADAPTATION_STRUCT|struct sctp_setadaptation v"
                       "HAVE_SACK_INFO_STRUCT|struct sctp_sack_info v"
                       "HAVE_ASSOC_VALUE_STRUCT|struct sctp_assoc_value v"
                       "HAVE_SCTP_UNCONFIRMED|int v=SCTP_UNCONFIRMED"
                       "HAVE_SCTP_PF|int v=SCTP_PF")
            string(REPLACE "|" ";" _probe "${_probe}")
            list(GET _probe 0 _definition)
            list(GET _probe 1 _body)
            check_c_source_compiles("${_sctp_headers}int main() { ${_body}; return 0; }" YATE_${_definition})
            if(YATE_${_definition})
                list(APPEND YATE_SCTP_DEFINITIONS ${_definition})
            endif()
        endforeach()
    endif()
endif()
cmake_pop_check_state()

